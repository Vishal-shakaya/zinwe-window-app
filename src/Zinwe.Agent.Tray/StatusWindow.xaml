<Window x:Class="Zinwe.Agent.Tray.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zinwe"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Zinwe.Font}"
        Foreground="{StaticResource Zinwe.Ink}">
    <StackPanel Margin="24,20,24,24">

        <!-- Brand row -->
        <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Zinwe.Orange}">
                <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Zinwe" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Status -->
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Zinwe.Muted}" VerticalAlignment="Center" />
            <TextBlock x:Name="Headline" Text="Checking…" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="Detail" Text="" Foreground="{StaticResource Zinwe.Muted}" TextWrapping="Wrap" Margin="20,4,0,0" />

        <!-- Facts -->
        <Border BorderBrush="{StaticResource Zinwe.Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="This PC" Foreground="{StaticResource Zinwe.Muted}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Hostname" Text="—" />
                <TextBlock Grid.Row="1" Text="Last check-in" Foreground="{StaticResource Zinwe.Muted}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastSeen" Text="—" />
                <TextBlock Grid.Row="2" Text="USB drives" Foreground="{StaticResource Zinwe.Muted}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UsbRule" Text="—" />
                <TextBlock Grid.Row="3" Text="Version" Foreground="{StaticResource Zinwe.Muted}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="Version" Text="—" />
            </Grid>
        </Border>

        <!-- Consent-first: say plainly what Zinwe does NOT do. -->
        <Border Background="#FFF4EE" CornerRadius="6" Padding="12,10" Margin="0,20,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Zinwe.Ink}">
                Zinwe protects your company's data on this PC.
                It does not record your keystrokes or take screenshots.
            </TextBlock>
        </Border>
    </StackPanel>
</Window>
