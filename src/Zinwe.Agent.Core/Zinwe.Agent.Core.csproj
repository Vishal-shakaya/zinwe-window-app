<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by the service and the tray app: backend contracts + client, device identity, IPC protocol. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets: the event queue only runs in the service, so SQLite (incl. the native e_sqlite3.dll) must not
      flow into the tray. Projects that use EventQueue (service, tests) reference Microsoft.Data.Sqlite themselves.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zinwe.Agent.Core.Tests" />
  </ItemGroup>

</Project>
